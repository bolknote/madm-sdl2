# Program: reveal "BOLK" on the S tube after Enter.
#
# Rows 3..7 start as masked values, not as readable letter rows.
# The program decodes one row at a time, so the S tube changes throughout
# execution instead of sitting in a long delay loop.
#
# Decode formula per row:
#   A = -masked_row
#   A = A - key
#   row = A
#
# key = -1879048192.  Display is LSB-left.

@0 11
@1 0x0000

@3 1860095552
@4 1868477888
@5 1872672320
@6 1868477888
@7 1859178048
@8 -1879048192

@12 0x4003
@13 0x8008
@14 0x6003
@15 0x4004
@16 0x8008
@17 0x6004
@18 0x4005
@19 0x8008
@20 0x6005
@21 0x4006
@22 0x8008
@23 0x6006
@24 0x4007
@25 0x8008
@26 0x6007
@27 0x8007
@28 0x6008
@29 0xE000
